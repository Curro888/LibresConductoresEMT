{
  "expo": {
    "name": "Libres Conductores EMT",
    "slug": "LibresConductoresEMT",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1e1b4b"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1e1b4b"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.curro888.libresconductoresemt"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1e1b4b"
        }
      ],
      "expo-secure-store",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "CalendarioMes",
              "label": "Calendario de libres",
              "description": "Tu mes con libres, festivos y cambios",
              "minWidth": "250dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "extra": {
      "eas": {
        "projectId": "f58b5000-5991-477f-bb69-1c8707f428bd"
      }
    },
    "owner": "curro888",
    "updates": {
      "url": "https://u.expo.dev/f58b5000-5991-477f-bb69-1c8707f428bd"
    },
    "scheme": "libresconductores"
  }
}
